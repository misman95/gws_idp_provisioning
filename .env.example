# ── Google Admin SDK ───────────────────────────────────────────
GOOGLE_SA_KEY_FILE=service_account.json
GOOGLE_ADMIN_EMAIL=admin@yourdomain.com
GOOGLE_DOMAIN=yourdomain.com
GOOGLE_CUSTOMER=my_customer

# ── Netskope ───────────────────────────────────────────────────
NETSKOPE_TENANT=https://<tenant>.goskope.com
NETSKOPE_API_TOKEN=

# ── 동기화 옵션 ────────────────────────────────────────────────
TARGET_GROUPS=
SYNC_USERS=all
DEPROVISION_MISSING=true
# Netskope SSL inspection 환경이면 false
SSL_VERIFY=false
DRY_RUN=false
API_CALL_DELAY=0.3
