# Copy to .env and fill in real values. Do not commit .env.
#   cp .env.example .env

# ── Google Admin SDK ───────────────────────────────────────────
# Service account JSON key path (keep the file out of git)
GOOGLE_SA_KEY_FILE=service_account.json

# Admin user impersonated via Domain-wide Delegation (needs Users/Groups read)
GOOGLE_ADMIN_EMAIL=admin@yourdomain.com

# Primary Workspace / Cloud Identity domain. Leave empty to use GOOGLE_CUSTOMER.
GOOGLE_DOMAIN=yourdomain.com
GOOGLE_CUSTOMER=my_customer

# ── Netskope ───────────────────────────────────────────────────
# Tenant URL or short name (example: https://acme.goskope.com)
NETSKOPE_TENANT=https://<tenant>.goskope.com

# REST API v2 token with Read+Write on /api/v2/scim/Users and /api/v2/scim/Groups
NETSKOPE_API_TOKEN=

# ── Sync options ───────────────────────────────────────────────
# Comma-separated group emails. Empty = all groups
TARGET_GROUPS=

# all     = every Google user
# members = only members of TARGET_GROUPS (or all groups if TARGET_GROUPS is empty)
SYNC_USERS=all

# Delete Netskope users/groups that disappeared from Google (uses sync_state.json)
DEPROVISION_MISSING=true

# false = skip TLS verify (Netskope SSL inspection / private CA)
SSL_VERIFY=false

DRY_RUN=false
API_CALL_DELAY=0.3
